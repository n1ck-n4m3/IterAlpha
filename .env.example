# Server-only. Copy to .dev.vars for local Worker preview; never commit real values.
# Configure the same names as runtime secrets/settings in Sites for production.
OPENAI_API_KEY=
OPENAI_MODEL=
ITERALPHA_ADMIN_USER_ID=
ITERALPHA_ADMIN_EMAIL=

# Optional open-model inference server. These values are never sent to browsers.
DECISION_API_URL=
DECISION_API_KEY=
DECISION_MODEL=Qwen/Qwen3.5-4B
DECISION_MODEL_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
# Enable only after obtaining permission for public display and automated use.
COINBASE_MARKET_DATA_LICENSED=false
# Optional always-on paper runner. Use a distinct random secret of 32+ characters.
SPIDER_RUNNER_KEY=
